{
  "name": "@cany748/eslint-config",
  "type": "module",
  "version": "7.0.0",
  "packageManager": "pnpm@12.10.1",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm typegen && tsdown --clean --dts",
    "typegen": "bun scripts/typegen.ts",
    "dev": "pnpm dlx @eslint/config-inspector --config eslint.config.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "release": "bumpp && pnpm publish",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "@unocss/eslint-plugin": "^66.10.5",
    "eslint-plugin-vue": "^10.11.1",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependenciesMeta": {
    "@unocss/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "dependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "local-pkg": "^1.2.1",
    "prettier": "^3.9.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@unocss/eslint-plugin": "^66.10.5",
    "bumpp": "^12.3.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-typegen": "^2.3.1",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
